{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.story-categories",
        "blocks.sponsors",
        "blocks.signup-banner",
        "blocks.parallax-banner",
        "blocks.hero"
      ]
    },
    "content": {
      "type": "richtext"
    },
    "author": {
      "type": "string"
    },
    "tag": {
      "type": "enumeration",
      "enum": [
        "Narrative",
        "Music Video",
        "Marketing & Advertisement",
        "Trailer",
        "Rendering & VFX",
        "Social Media",
        "Open Format",
        "Behind The Scenes"
      ]
    }
  }
}
